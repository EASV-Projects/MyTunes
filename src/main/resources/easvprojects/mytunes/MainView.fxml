<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="760.0" prefWidth="1280.0" styleClass="app-root" stylesheets="@main.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="easvprojects.mytunes.gui.controller.MainController">


    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="top-bar">
            <padding>
                <Insets bottom="14.0" left="22.0" right="22.0" top="14.0" />
            </padding>


            <HBox alignment="CENTER" spacing="10.0">
                <Button fx:id="prevButton" onAction="#onBtnPrevious" styleClass="icon-btn" text="⏮" />
                <Button fx:id="playPauseButton" onAction="#onBtnPlayPause" styleClass="play-btn" text="⏸" />
                <Button fx:id="nextButton" onAction="#onBtnNext" styleClass="icon-btn" text="⏭" />
            </HBox>


            <HBox alignment="CENTER_LEFT" minWidth="200.0" spacing="12.0">
                <Region fx:id="coverArtBox" prefHeight="44.0" prefWidth="44.0" styleClass="cover-art" />
                <VBox alignment="CENTER_LEFT" spacing="2.0">
                    <Label fx:id="currentTitleLabel" styleClass="track-title" />
                    <Label fx:id="currentArtistLabel" styleClass="track-subtitle" />
                </VBox>
            </HBox>


            <HBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                <Label fx:id="currentTimeLabel" styleClass="time-label" />
                <Slider fx:id="seekSlider" styleClass="seek-slider" HBox.hgrow="ALWAYS" />
                <Label fx:id="totalTimeLabel" styleClass="time-label" />
            </HBox>


            <HBox alignment="CENTER" prefWidth="140.0" spacing="8.0">
                <Label styleClass="volume-icon" text="🔊" />
                <Slider fx:id="volumeSlider" prefWidth="100.0" styleClass="volume-slider" value="65.0" />
            </HBox>

            <!-- Search & Filter -->
            <HBox alignment="CENTER" spacing="8.0">
                <TextField fx:id="filterField" prefWidth="220.0" promptText="Filter by title or artist..." styleClass="search-field" />
                <Button fx:id="filterButton" onAction="#onBtnFilter" styleClass="accent-btn" text="Filter" />
            </HBox>
        </HBox>
    </top>


    <center>
        <HBox spacing="16.0" styleClass="main-columns">
            <padding>
                <Insets bottom="22.0" left="22.0" right="22.0" top="14.0" />
            </padding>


            <VBox minWidth="270.0" prefWidth="310.0" spacing="12.0" styleClass="panel-card">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>

                <Label styleClass="section-header" text="PLAYLISTS" />

                <TableView fx:id="playlistTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="playlistNameCol" prefWidth="140.0" text="Name" />
                        <TableColumn fx:id="playlistSongsCol" prefWidth="60.0" text="Songs" />
                        <TableColumn fx:id="playlistTimeCol" prefWidth="75.0" text="Time" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox spacing="8.0">
                    <Button fx:id="newPlaylistButton" onAction="#onBtnNewPlaylist" styleClass="subtle-btn" text="New..." />
                    <Button fx:id="editPlaylistButton" onAction="#onBtnEditPlaylist" styleClass="subtle-btn" text="Edit..." />
                    <Button fx:id="deletePlaylistButton" onAction="#onBtnDeletePlaylist" styleClass="danger-btn" text="Delete" />
                </HBox>
            </VBox>


            <VBox minWidth="250.0" prefWidth="290.0" spacing="12.0" styleClass="panel-card">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>

                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="section-header" text="SONGS IN PLAYLIST" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectedPlaylistLabel" styleClass="section-meta" />
                </HBox>

                <ListView fx:id="playlistSongsListView" styleClass="playlist-list" VBox.vgrow="ALWAYS" />

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Button fx:id="moveSongUpButton" onAction="#onBtnMoveSongUp" styleClass="subtle-btn" text="↑" />
                    <Button fx:id="moveSongDownButton" onAction="#onBtnMoveSongDown" styleClass="subtle-btn" text="↓" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="removeSongFromPlaylistButton" onAction="#onBtnRemoveSongFromPlaylist" styleClass="danger-btn" text="Delete" />
                </HBox>
            </VBox>


            <VBox alignment="CENTER">
                <Button fx:id="addSongToPlaylistButton" onAction="#onBtnAddSongToPlaylist" styleClass="transfer-btn" text="←" />
            </VBox>


            <VBox spacing="12.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                </padding>

                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="section-header" text="ALL SONGS" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="songCountLabel" styleClass="section-meta" />
                </HBox>

                <TableView fx:id="songTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="songTitleCol" prefWidth="210.0" text="Title" />
                        <TableColumn fx:id="songArtistCol" prefWidth="170.0" text="Artist" />
                        <TableColumn fx:id="songCategoryCol" prefWidth="130.0" text="Category" />
                        <TableColumn fx:id="songTimeCol" text="Time" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox spacing="8.0">
                    <Button fx:id="newSongButton" onAction="#onBtnNewSong" styleClass="subtle-btn" text="New..." />
                    <Button fx:id="editSongButton" onAction="#onBtnEditSong" styleClass="subtle-btn" text="Edit..." />
                    <Button fx:id="deleteSongButton" onAction="#onBtnDeleteSong" styleClass="danger-btn" text="Delete" />
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
